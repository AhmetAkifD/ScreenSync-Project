<Window x:Class="ScreenSync.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:local="clr-namespace:ScreenSync.Desktop"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Cihaz Keşif Merkezi" FontSize="24" Foreground="White" Margin="0,0,0,20"/>

        <vlc:VideoView x:Name="ScreenViewer" Margin="0,10,0,10" Grid.Row="1" />


        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BtnStartDiscovery" Content="Yayın Başlat (PC'yi Görünür Yap)" 
                    Width="200" Height="40" Background="#007ACC" Foreground="White" Click="BtnStartDiscovery_Click"/>
        </StackPanel>
    </Grid>
</Window>
