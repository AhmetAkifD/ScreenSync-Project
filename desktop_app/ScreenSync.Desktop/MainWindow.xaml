<Window x:Class="ScreenSync.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenSync - Ana Sayfa" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        Background="#121212" MinWidth="1080" MinHeight="800">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2C2C2C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D3D3D"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#1A1A1A"/>
                    <Setter Property="Foreground" Value="#555555"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#121212" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#252525" Padding="20,15" CornerRadius="16" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.4" ShadowDepth="4"/>
            </Border.Effect>
            <Grid>
                <TextBlock Text="ScreenSync" Foreground="White" VerticalAlignment="Center" FontWeight="Bold" FontSize="18"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnListenPort" Content="Cihaz Ara" Click="BtnListenPort_Click" Margin="0,0,20,0" Background="#2C2C2C"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Ellipse x:Name="StatusLight" Width="12" Height="12" Fill="#F44336" Margin="0,0,8,0">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#F44336" BlurRadius="8" Opacity="0.8" ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="TxtLightStatus" Text="Veri Bekleniyor..." Foreground="#B3B3B3" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="16" Margin="0,0,0,15" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="★ Favori Cihazlar" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="PanelFavorites" Orientation="Horizontal"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="16" Margin="0,0,0,15" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Görünür Cihazlar" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="PanelActiveDevices" Orientation="Horizontal"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="16" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Geçmiş Bağlantılar" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="PanelHistoryDevices" Orientation="Horizontal"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>