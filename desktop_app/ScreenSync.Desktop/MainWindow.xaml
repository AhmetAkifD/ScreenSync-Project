<Window x:Class="ScreenSync.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScreenSync.Desktop"
        mc:Ignorable="d"
        Title="ScreenSync Kontrol Merkezi" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" MinWidth="1080" MinHeight="720">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#252526" Padding="10,15" BorderBrush="#333" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="Ekran Paylaşım Servisi" Foreground="#888" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" Margin="10,0,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnListenPort" Content="Portu Dinlemeye Başla" Click="BtnListenPort_Click" Height="35" Margin="0,0,15,0" Background="#2D2D2D"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                        <Ellipse x:Name="StatusLight" Width="12" Height="12" Fill="#F44336" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtLightStatus" Text="Veri Bekleniyor..." Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button x:Name="BtnShowStream" Content="Yayını Başlat" Click="BtnShowStream_Click" Height="35" IsEnabled="False" Background="#4CAF50"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1A1A1A" BorderBrush="#333" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,20,0,0">
                    <Button Height="45" Width="45" Margin="0,0,0,15" Background="Transparent" ToolTip="Ana Sayfa">
                        <TextBlock Text="&#xf015;" FontFamily="Segoe UI Symbol" Foreground="White" FontSize="20"/>
                    </Button>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="1.5*"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="★ Favori Cihazlar" Foreground="#FFD700" FontSize="18" FontWeight="SemiBold" Margin="5,0,0,10"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="PanelFavorites" Orientation="Horizontal"/>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="1" BorderBrush="#333" BorderThickness="0,1,0,0" Margin="0,7"/>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Görünür Cihazlar" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="5,0,0,10"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="PanelActiveDevices" Orientation="Horizontal"/>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="3" BorderBrush="#333" BorderThickness="0,1,0,0" Margin="0,7"/>

                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Geçmiş Bağlantılar" Foreground="#888" FontSize="18" FontWeight="SemiBold" Margin="5,0,0,10"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="PanelHistoryDevices" Orientation="Horizontal"/>
                    </ScrollViewer>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>