<Window x:Class="ScreenSync.Desktop.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenSync - Admin Log Console" Height="400" Width="600"
        Background="#1E1E1E">
    <Grid Margin="10">
        <ListBox x:Name="LogListBox" 
                 Background="#252526" 
                 Foreground="#D4D4D4" 
                 BorderThickness="0"
                 FontFamily="Consolas"
                 ItemsSource="{Binding Logs}">
        </ListBox>
    </Grid>
</Window>